<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
         <style type="text/css"><![CDATA[
    /* 전체 레이아웃 */
    .sub_contents {
      display: flex;
      height: 100%;
      background-color: #f0f4f8;
    }
    .lybox {
      display: flex;
      width: 100%;
      height: 100%;
    }
    .col_5 {
      flex: 1;
      box-sizing: border-box;
    }

    /* 왼쪽 비디오 영역 */
    .col_5:first-child video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      background-color: #2e3a46;
    }

    /* 오른쪽 컨텐츠 */
    .col_5:last-child {
      padding: 24px;
      display: flex;
      flex-direction: column;
      gap: 16px;
      background-color: #ffffff;
    }

    /* 타이틀(로고 · 회의명 · 참여자 레이블) */
    .titbox {
      display: flex;
      align-items: center;
    }
    .titbox w2\\:textbox[label="ModuLink"],
    .titbox w2\\:textbox[label="미팅룸 제목입니다"] {
      font-size: 18px;
      font-weight: bold;
      color: #4a85c2;
      margin-right: 8px;
    }
    .titbox w2\\:textbox[tagname="h6"] {
      font-size: 14px;
      color: #4a85c2;
      margin-top: 8px;
    }

    /* 입력 폼 */
    xf\\:input {
      width: 100%;
      max-width: 200px;
      padding: 8px 12px;
      border: 1px solid #4a85c2;
      border-radius: 4px;
      font-size: 14px;
      color: #333;
      background-color: #f9fcff;
      margin-bottom: 12px;
    }
    xf\\:input:focus {
      border-color: #2d6fb7;
      outline: none;
      box-shadow: 0 0 0 2px rgba(74, 133, 194, 0.3);
    }

    /* 장치 상태 확인 메시지 */
    .txt_info {
      font-size: 16px;
      font-weight: 600;
      color: #4a85c2;
      margin-top: 16px;
      margin-bottom: 8px;
    }
    .txt_success {
      font-size: 14px;
      color: #2d6fb7;
      margin-left: 16px;
      margin-bottom: 6px;
    }

    /* 입장하기 버튼 */
    .btn_cm {
      display: inline-block;
      padding: 12px 0;
      width: 100%;
      max-width: 220px;
      text-align: center;
      background: linear-gradient(90deg, #4a85c2, #6aa8e0);
      color: #ffffff;
      font-size: 16px;
      font-weight: bold;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      margin-top: auto;
    }
    .btn_cm:hover {
      background: linear-gradient(90deg, #3b6fa1, #5895c6);
    }
  ]]></style>
