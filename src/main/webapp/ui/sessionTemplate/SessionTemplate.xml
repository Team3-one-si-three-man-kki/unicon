scwin.btn_load_onclick = function (e) {
    console.log("불러오기 버튼 클릭됨");
    
    // 유효성 체크
    var valInfo = [
        { id: "templateId", mandatory: true }
    ];

    if ($c.data.validateGroup(grp_sessionTemplateInfo, valInfo) === true) {
        console.log("유효성 체크 통과");
        
        var promise = $c.win.confirm("해당 템플릿을 불러오시겠습니까?");
        promise.then(function (result) {
            console.log("컨펌 결과:", result);
            
            if (result) {
                var templateData = dmp_sessionTemplateVoDetail.getJSON();
                console.log("전달할 데이터:", templateData);
                
                // 부모 창의 함수를 직접 호출
                $p.parent().scwin.applyTemplateLayout(templateData);
                
                // 팝업 닫기
                $p.closePopup();
            }
        })
    } else {
        console.log("유효성 체크 실패");
