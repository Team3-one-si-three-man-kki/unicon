<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map" />
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<style type="text/css"><![CDATA[
/* AI 모니터링 대시보드 슬라이드 패널 */
#aiDashboardSlide {
    position: fixed;
    top: 0;
    right: -400px; /* 초기에는 화면 밖에 숨김 */
    width: 380px;
    height: 100vh;
    background: white;
    box-shadow: -4px 0 20px rgba(0,0,0,0.15);
    z-index: 1000;
    transition: right 0.3s ease-in-out;
    overflow: hidden;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    display: flex;
    flex-direction: column;
}

#aiDashboardSlide.open {
    right: 0; /* 열릴 때 화면에 표시 */
}

/* 헤더 */
.dashboard-header {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.dashboard-title {
    font-size: 1.1rem;
    font-weight: bold;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.close-btn {
    background: rgba(255,255,255,0.2);
    border: none;
    color: white;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    transition: background 0.2s;
}

.close-btn:hover {
    background: rgba(255,255,255,0.3);
}

/* 전체 통계 */
.overall-stats {
    background: #f8f9fa;
    padding: 1rem;
    border-bottom: 1px solid #e1e5e9;
}

.overall-title {
    font-size: 0.9rem;
    color: #666;
    margin-bottom: 0.75rem;
    text-align: center;
}

.participation-rate {
    text-align: center;
    margin-bottom: 1rem;
}

.rate-circle {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: conic-gradient(#4CAF50 0deg 270deg, #e0e0e0 270deg 360deg);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 0.5rem;
    position: relative;
}

.rate-circle::before {
    content: '';
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: white;
    position: absolute;
}

.rate-text {
    font-size: 1.2rem;
    font-weight: bold;
    color: #333;
    z-index: 1;
}

.rate-label {
    font-size: 0.8rem;
    color: #666;
}

.status-summary {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.5rem;
    text-align: center;
}

.status-item {
    padding: 0.5rem;
    border-radius: 6px;
    font-size: 0.8rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
}

.status-item.excellent {
    background: #e8f5e8;
    color: #2e7d2e;
}

.status-item.good {
    background: #e3f2fd;
    color: #1976d2;
}

.status-item.warning {
    background: #fff3e0;
    color: #f57c00;
}

.status-item.absent {
    background: #ffebee;
    color: #d32f2f;
}

/* 참여자 목록 */
.participants-section {
    flex: 1;
    overflow-y: auto;
    padding: 1rem;
}

.section-title {
    font-size: 0.9rem;
    color: #666;
    margin-bottom: 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.participant-count {
    font-size: 0.8rem;
    background: #e1e5e9;
    padding: 0.25rem 0.5rem;
    border-radius: 12px;
    margin-right: 0.5rem;
}

.participants-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

/* 참여자 카드 */
.participant-card {
    background: white;
    border: 1px solid #e1e5e9;
    border-radius: 8px;
    padding: 1rem;
    transition: all 0.2s;
    position: relative;
}

.participant-card:hover {
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

.participant-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
}

.participant-name {
    font-weight: 600;
    color: #333;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.participant-avatar {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #667eea;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    font-weight: bold;
}

.status-badge {
    padding: 0.25rem 0.5rem;
    border-radius: 12px;
    font-size: 0.7rem;
    font-weight: 500;
}

.status-badge.excellent {
    background: #e8f5e8;
    color: #2e7d2e;
}

.status-badge.good {
    background: #e3f2fd;
    color: #1976d2;
}

.status-badge.warning {
    background: #fff3e0;
    color: #f57c00;
}

.status-badge.absent {
    background: #ffebee;
    color: #d32f2f;
}

.participant-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    font-size: 0.8rem;
}

.stat-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.stat-label {
    color: #666;
}

.stat-value {
    font-weight: 500;
    color: #333;
}

.participation-bar {
    width: 100%;
    height: 4px;
    background: #e0e0e0;
    border-radius: 2px;
    margin-top: 0.5rem;
    overflow: hidden;
}

.participation-fill {
    height: 100%;
    background: linear-gradient(90deg, #4CAF50, #8BC34A);
    border-radius: 2px;
    transition: width 0.3s ease;
}

/* 현재 상태 표시 */
.current-status {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    display: flex;
    gap: 0.25rem;
}

.status-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
}

.status-indicator.present {
    background: #4CAF50;
}

.status-indicator.absent {
    background: #ff4757;
}

.status-indicator.drowsy {
    background: #ffa502;
    animation: blink 1s infinite;
}

@keyframes blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0.3; }
}

/* 새로고침 버튼 */
.refresh-btn {
    background: #f5f7fa;
    border: 1px solid #ddd;
    padding: 0.25rem;
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.8rem;
    color: #666;
    transition: all 0.2s;
}

.refresh-btn:hover {
    background: #e1e5e9;
}

/* 빈 상태 */
.empty-state {
    text-align: center;
    padding: 2rem 1rem;
    color: #666;
}

/* 모바일 대응 */
@media (max-width: 768px) {
    #aiDashboardSlide {
        width: 100vw;
        right: -100vw;
    }
    
    #aiDashboardSlide.open {
        right: 0;
    }
}
]]>
		</style>

		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
    console.log('[AI Dashboard] 대시보드 컴포넌트 로드됨');
};
]]>
		</script>
	</head>
	<body class="" ev:onpageload="scwin.onpageload">
		<!-- AI 모니터링 대시보드 슬라이드 패널 -->
		<w2:group id="aiDashboardSlide" class="slide-panel">
			<!-- 헤더 -->
			<w2:group class="dashboard-header">
				<w2:group class="dashboard-title">
					<w2:textbox>📊 실시간 집중도 모니터링</w2:textbox>
				</w2:group>
				<w2:button class="close-btn" onclick="scwin.closeDashboard()">×</w2:button>
			</w2:group>

			<!-- 전체 통계 -->
			<w2:group class="overall-stats">
				<w2:group class="overall-title">
					<w2:textbox>전체 평균 집중도</w2:textbox>
				</w2:group>
				
				<w2:group class="participation-rate">
					<w2:group id="participationCircle" class="rate-circle">
						<w2:textbox id="averageParticipationRate" class="rate-text">78%</w2:textbox>
					</w2:group>
					<w2:group class="rate-label">
						<w2:textbox>24명 중 3명 우수 / 2명 자리비움 감지</w2:textbox>
					</w2:group>
				</w2:group>

				<w2:group class="status-summary">
					<w2:group class="status-item excellent">
						<w2:textbox>우수</w2:textbox>
						<w2:textbox id="status-excellent">3</w2:textbox>
					</w2:group>
					<w2:group class="status-item good">
						<w2:textbox>양호</w2:textbox>
						<w2:textbox id="status-good">2</w2:textbox>
					</w2:group>
					<w2:group class="status-item warning">
						<w2:textbox>주의</w2:textbox>
						<w2:textbox id="status-warning">1</w2:textbox>
					</w2:group>
					<w2:group class="status-item absent">
						<w2:textbox>자리비움</w2:textbox>
						<w2:textbox id="status-absent">1</w2:textbox>
					</w2:group>
				</w2:group>
			</w2:group>

			<!-- 참여자 목록 -->
			<w2:group class="participants-section">
				<w2:group class="section-title">
					<w2:textbox>참여자별 상태</w2:textbox>
					<w2:group>
						<w2:textbox id="totalParticipants" class="participant-count">6명</w2:textbox>
						<w2:button class="refresh-btn" onclick="scwin.refreshData()">🔄</w2:button>
					</w2:group>
				</w2:group>
				
				<w2:group id="participantsList" class="participants-list">
					<!-- 샘플 참여자 카드들 -->
					<w2:group class="participant-card">
						<w2:group class="current-status">
							<w2:group class="status-indicator present"></w2:group>
						</w2:group>
						<w2:group class="participant-header">
							<w2:group class="participant-name">
								<w2:group class="participant-avatar">이</w2:group>
								<w2:textbox>이민수</w2:textbox>
							</w2:group>
							<w2:group class="status-badge excellent">우수</w2:group>
						</w2:group>
						<w2:group class="participant-stats">
							<w2:group class="stat-item">
								<w2:textbox class="stat-label">참여도</w2:textbox>
								<w2:textbox class="stat-value">95%</w2:textbox>
							</w2:group>
							<w2:group class="stat-item">
								<w2:textbox class="stat-label">자리비움</w2:textbox>
								<w2:textbox class="stat-value">0회</w2:textbox>
							</w2:group>
							<w2:group class="stat-item">
								<w2:textbox class="stat-label">수면감지</w2:textbox>
								<w2:textbox class="stat-value">0회</w2:textbox>
							</w2:group>
							<w2:group class="stat-item">
								<w2:textbox class="stat-label">자리비움 시간</w2:textbox>
								<w2:textbox class="stat-value">42분</w2:textbox>
							</w2:group>
						</w2:group>
						<w2:group class="participation-bar">
							<w2:group class="participation-fill" style="width: 95%"></w2:group>
						</w2:group>
					</w2:group>
				</w2:group>
			</w2:group>
		</w2:group>
	</body>
</html>