<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
        	<w2:dataCollection baseNode="map">
        		<w2:dataMap id="dm_loginCustomInfo" ev:onmodelchange="scwin.dm_loginCustomInfo_onmodelchange">
        			<w2:keyInfo>
        				<w2:key id="backgroundImage" name="backgroundImage" dataType="text"></w2:key>
        				<w2:key id="logo" name="logo" dataType="text"></w2:key>
        				<w2:key id="logoSize" name="logoSize" dataType="text"></w2:key>
        				<w2:key id="mainTitle" name="mainTitle" dataType="text"></w2:key>
        				<w2:key id="mainTitleColor" name="mainTitleColor" dataType="text"></w2:key>
        				<w2:key id="mainTitleSize" name="mainTitleSize" dataType="text"></w2:key>
        				<w2:key id="mainTitleFont" name="mainTitleFont" dataType="text"></w2:key>
        				<w2:key id="subTitle" name="subTitle" dataType="text"></w2:key>
        				<w2:key id="subTitleColor" name="subTitleColor" dataType="text"></w2:key>
        				<w2:key id="subTitleSize" name="subTitleSize" dataType="text"></w2:key>
        				<w2:key id="subTitleFont" name="subTitleFont" dataType="text"></w2:key>
        				<w2:key id="extraTitle" name="extraTitle" dataType="text"></w2:key>
        				<w2:key id="extraTitleColor" name="extraTitleColor" dataType="text"></w2:key>
        				<w2:key id="extraTitleSize" name="extraTitleSize" dataType="text"></w2:key>
        				<w2:key id="extraTitleFont" name="extraTitleFont" dataType="text"></w2:key>
        				<w2:key id="overlayOpacity" name="overlayOpacity" dataType="text"></w2:key>
        				<w2:key id="overlayColor" name="overlayColor" dataType="text"></w2:key>
        				<w2:key id="primaryColor" name="primaryColor" dataType="text"></w2:key>
        				<w2:key dataType="text" name="accentColor" id="accentColor"></w2:key>
        				<w2:key dataType="text" name="tenantName" id="tenantName"></w2:key>
        			</w2:keyInfo>
        		</w2:dataMap>
        		<w2:dataMap baseNode="map" id="dm_loginPage_request">
        			<w2:keyInfo>
        				<w2:key dataType="text" name="configJson" id="configJson"></w2:key>
        				<w2:key dataType="text" name="테넌트ID" id="tenantId"></w2:key>
        			</w2:keyInfo>
        		</w2:dataMap>
        		<w2:dataMap baseNode="map" id="dm_subdomain">
        			<w2:keyInfo>
        				<w2:key dataType="text" name="name1" id="mode"></w2:key>
        				<w2:key dataType="text" name="name2" id="subDomain"></w2:key>
        			</w2:keyInfo>
        		</w2:dataMap>
        	</w2:dataCollection>
        	<w2:workflowCollection />
        	<xf:submission id="loadPreview" action="/InsWebApp/LCP0001List.pwkjson" method="post" mediatype="application/json" ref='data:json,{"id":"dm_subdomain","key":"tenant"}'
        		target='data:json,dm_loginCustomInfo' encoding="UTF-8" instance="" replace="" errorHandler=""
        		customHandler="" mode="asynchronous" processMsg="" ev:submit="" ev:submitdone="scwin.loadPreview_submitdone" ev:submiterror=""
        		abortTrigger="">
        	</xf:submission>
        	<xf:submission id="sbm_saveConfig" action="/InsWebApp/LCP0001Save.pwkjson" method="post" mediatype="application/json" ref='data:json,{"id":"dm_loginPage_request","key":"vo"}'
        		target="" encoding="UTF-8" instance="" replace="" errorHandler="" customHandler="" mode="asynchronous" processMsg="저장중입니다..." ev:submit=""
        		ev:submitdone="scwin.sbm_saveConfig_submitdone" ev:submiterror="" abortTrigger="">
        	</xf:submission>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {
};

scwin.updateCustomData = function (key, value) {
    dm_customData.set(key, value);

    var previewFrame = $p.getFrame("loginPage");
    console.log(previewFrame)
    if (previewFrame) {
        previewFrame.loginCustomInfo.set(key, value);
    }
};

scwin.loginPage_onpageframeload = function () {
    scwin.params = new URLSearchParams(window.location.search);
    dm_subdomain.set("subDomain", scwin.params.get("tenant"))
    dm_subdomain.set("mode", "custom")
    $c.sbm.execute(loadPreview)
};

scwin.loadPreview_submitdone = function (e) {
    let elData = e.responseJSON

    if (Object.keys(elData).length === 1) {
        elData = scwin.defaultData(elData.tenantName);
    }
    
    dm_loginCustomInfo.setJSON(elData)

    tabControl1.getWindow().scwin.setDataAndRender();
    loginPage.getWindow().scwin.applyCustomization(elData);
};

scwin.dm_loginCustomInfo_onmodelchange = function (info) {
    var previewWindow = loginPage.getWindow();
    if (previewWindow && typeof previewWindow.scwin.applyCustomization === "function") {
        previewWindow.scwin.applyCustomization(dm_loginCustomInfo.getJSON());
    }
};

scwin.btn_save_onclick = function (e) {
    var styleData = dm_loginCustomInfo.getJSON();

    var configJsonString = JSON.stringify(styleData);

    dm_loginPage_request.set("configJson", configJsonString);
    dm_loginPage_request.set("tenantId", scwin.params.get("tenant"));

    $p.executeSubmission("sbm_saveConfig");
};

scwin.sbm_saveConfig_submitdone = function (e) {
};

scwin.defaultData = function (name) {
    const data = {
        backgroundImage: 'https://images.unsplash.com/photo-1497366216548-37526070297c?w=800&h=600&fit=crop', // 깔끔한 오피스 이미지
        logo: '',
        logoSize: 60,
        mainTitle: '비즈니스의 새로운 시작을 환영합니다.',
        mainTitleSize: 36,
        mainTitleColor: '#ffffff',
        mainTitleFont: 'font-semibold',
        subTitle: '안전하고 효율적인 비즈니스 솔루션',
        subTitleSize: 18,
        subTitleColor: '#e5e7eb',
        subTitleFont: 'font-normal',
        extraTitle: '안전하고 신뢰할 수 있는 플랫폼으로 더 나은 비즈니스를 위한 첫걸음을 시작하세요',
        extraTitleSize: 16,
        extraTitleColor: '#d1d5db',
        extraTitleFont: 'font-light',
        overlayOpacity: 35,
        overlayColor: '#1f2937',
        primaryColor: '#3b82f6',
        accentColor: '#6366f1',
        tenantName : name
    }
    return data;
}]]></script>
    </head>
   <body ev:onpageload="scwin.onpageload">
	<xf:group class="sub_contents" id="" style="">

		<xf:group class="pgtbox" id="" style="margin-top: 17px;">
			<w2:textbox class="pgt_tit" id="" label="로그인 페이지 커스터마이징" style="" tagname="h2"></w2:textbox>
			<xf:group class="breadcrumb" id="" style="">
				<xf:group id="" style="" tagname="ul">
					<xf:group class="home" id="" style="" tagname="li">
						<w2:anchor id="" outerDiv="false" style="">
							<xf:label><![CDATA[Home]]></xf:label>
						</w2:anchor>
					</xf:group>
					<xf:group id="" style="" tagname="li">
						<w2:anchor id="" outerDiv="false" style="">
							<xf:label><![CDATA[로그인 페이지 커스터마이징]]></xf:label>
						</w2:anchor>
					</xf:group>
				</xf:group>
			</xf:group>
		</xf:group>
		<xf:group class="lybox" id="" style="">
			<xf:group adaptiveThreshold="" class="col_fix" id="" style="width: 370px;">
				<w2:textbox style="font-size: 15px;margin-bottom: 20px;" id="" label="테넌트별 로그인 페이지를 디자인하세요"></w2:textbox>
				<xf:group class="tbcbox" id="">
					<xf:group class="tbcbox" id="">
						<w2:tabControl alwaysDraw="false" class="tbc" id="tabControl1" style="">
							<w2:tabs disabled="false" id="tabs19" label="배경" style=""></w2:tabs>
							<w2:tabs disabled="false" id="tabs20" label="텍스트" style=""></w2:tabs>
							<w2:tabs disabled="false" id="tabs21" label="색" style=""></w2:tabs>
							<w2:tabs disabled="false" style="" id="tabs22" label="로고"></w2:tabs>
							<w2:content alwaysDraw="false" id="content19" style="" src="/InsWebApp/ui/login_custom_tab/background_custom.xml"></w2:content>
							<w2:content alwaysDraw="false" id="content20" style="" src="/InsWebApp/ui/login_custom_tab/title_custom.xml"></w2:content>
							<w2:content alwaysDraw="false" id="content21" style="" src="/InsWebApp/ui/login_custom_tab/color_custom.xml"></w2:content>
							<w2:content alwaysDraw="false" style="" id="content22" src="/InsWebApp/ui/login_custom_tab/logo_custom.xml"></w2:content>
						</w2:tabControl>
					</xf:group>
					<xf:trigger style="width: 100%;padding: 10px;color:white;background:#66aaab;" id="btn_save" type="button" ev:onclick="scwin.btn_save_onclick">
						<xf:label><![CDATA[변경사항 저장]]></xf:label>
					</xf:trigger>
				</xf:group>
			</xf:group>
			<xf:group class="" id="" style="" localeRef="">
				<w2:pageFrame style="" id="loginPage" src="/InsWebApp/main/unicon_tenant_login_page.xml?mode=preview" ev:onpageframeload="scwin.loginPage_onpageframeload"></w2:pageFrame>
			</xf:group>
		</xf:group>
	</xf:group>
</body>
</html>
