		<script lazy="false" type="text/javascript"><![CDATA[scwin.onpageload = function() {
    // URL 파라미터에서 sessionId 받기
    var sessionId;
    
    // localStorage에서 받기
    if (!sessionId) {
        try {
            sessionId = localStorage.getItem('currentSessionId');
            console.log('전달받은 sessionId: ', sessionId);
        } catch(e) {
            alert('세션 아이디를 넘겨받지 못했습니다.')
        }
    }
    
    if (sessionId) {
        scwin.currentSessionId = sessionId;
        scwin.loadSessionModules(sessionId);
    } else {
        alert("세션 정보를 찾을 수 없습니다. 다시 시도해주세요.");
    }
};

// 모듈 배치 정보 로드 함수
scwin.loadSessionModules = function(sessionId) {
    dma_sessionRequest.set("sessionId", sessionId);
    $p.executeSubmission("sbm_getSessionModuleDetails");
};

//--------------------------모듈 불러오기--------------------------

scwin.loadLayout = function () {
    var sessionId = scwin.currentSessionId;

    if (!sessionId) {
        alert("세션 정보가 없습니다.");
        return;
    }

    dma_sessionRequest.set("sessionId", sessionId);
    $p.executeSubmission("sbm_getSessionModuleDetails");
};


scwin.sbm_getSessionModuleDetails_submitdone = function (e) {
    if (e && e.responseJSON && e.responseJSON.elData) {
        var sessionModuleList = e.responseJSON.elData.sessionModuleDetailVoList;

        if (sessionModuleList && sessionModuleList.length > 0) {
            scwin.restoreModuleLayout(sessionModuleList);
        }
    }
};

scwin.sbm_getSessionModuleDetails_submiterror = function (e) {
    alert("모듈 목록을 불러오는데 실패했습니다.");
};

// 모듈 배치 복원 함수
scwin.restoreModuleLayout = function (sessionModules) {
    // 모든 영역 초기화
    scwin.clearAllAreas();

    // 각 모듈을 해당 위치에 배치
    sessionModules.forEach(function (sessionModule) {
        var config = JSON.parse(sessionModule.sessionModuleConfig);

        // area 정보에서 실제 영역 ID 추출
        var areaId = config.area;
        if (areaId && areaId.indexOf("mf_") === 0) {
            areaId = areaId.replace("mf_fr_session_making_process", "mf");
        }

        var moduleInfo = {
            moduleId: sessionModule.moduleId,
            code: sessionModule.code,
            name: sessionModule.name,
            description: sessionModule.description,
            icon: sessionModule.icon
        };

        scwin.displayModuleInArea(areaId, moduleInfo);
    });
};

// 모든 영역 초기화 함수
scwin.clearAllAreas = function () {
    for (var i = 1; i <= 6; i++) {
        var areaId = "grp_area" + i;
        var areaElement = document.getElementById(areaId);

        if (areaElement) {
            // 스타일 초기화
            areaElement.classList.remove('occupied');

            // 라벨 초기화
            var labelElement = areaElement.querySelector('span');
            if (labelElement) {
                // 원래 라벨로 복원
                var originalLabels = {
                    1: "메인 영역 - 화상채팅 (영역 1)",
                    2: "사이드 패널 (영역 2)",
                    3: "채팅 영역 (영역 3)",
                    4: "도구 영역 (영역 4)",
                    5: "상태 패널 (영역 5)",
                    6: "추가 기능 (영역 6)"
                };

                labelElement.textContent = originalLabels[i];
                labelElement.style.color = "";
                labelElement.style.fontWeight = "";
                labelElement.style.textShadow = "";
            }

            // 데이터 속성 제거
            delete areaElement.dataset.moduleId;
            delete areaElement.dataset.hasModule;
        }
    }
};

// 영역에 모듈 정보 표시하는 함수
scwin.displayModuleInArea = function (areaId, moduleInfo) {
    var areaElement = document.getElementById(areaId);
    if (!areaElement) {
        return;
    }

    // 스타일 변경
    areaElement.classList.add('occupied');

    // 라벨 변경
    var labelElement = areaElement.querySelector('span');
    if (labelElement) {
        labelElement.innerHTML = moduleInfo.icon + " " + moduleInfo.name;
        labelElement.style.color = "white";
        labelElement.style.fontWeight = "600";
        labelElement.style.textShadow = "0 2px 8px rgba(0,0,0,0.5)";
    }

    // 데이터 속성 설정
    areaElement.dataset.moduleId = moduleInfo.moduleId || "";
    areaElement.dataset.hasModule = "true";
};

]]></script>
