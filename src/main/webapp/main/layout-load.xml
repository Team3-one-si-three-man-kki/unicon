		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataMap baseNode="map" id="dma_sessionRequest">
					<w2:keyInfo>
						<w2:key dataType="text" name="sessionId" id="sessionId"></w2:key>
					</w2:keyInfo>
				</w2:dataMap>
			</w2:dataCollection>
			<w2:workflowCollection />
			<xf:submission id="sbm_getSessionModuleDetails" action="/InsWebApp/TNU0002SessionModuleDetailListBySessionId.pwkjson" method="post"
				mediatype="application/json" ref='data:json,{"id":"dma_sessionRequest","key":"requestData"}' target="" encoding="UTF-8" instance="" replace="" errorHandler="" customHandler=""
				mode="asynchronous" processMsg="" ev:submit="" ev:submitdone="scwin.sbm_getSessionModuleDetails_submitdone"
				ev:submiterror="scwin.sbm_getSessionModuleDetails_submiterror" abortTrigger="">
			</xf:submission>
		</xf:model>
