<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
         <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
                <w2:dataMap baseNode="map" id="dma_checkout">
                    <w2:keyInfo>
                        <w2:key dataType="text" name="체크시간" id="checkTime"/>
                        <w2:key dataType="text" name="체크날짜" id="checkDate"/>
                    </w2:keyInfo>
                    <w2:data use="true">
                        <checkTime>16:54</checkTime>
                        <checkDate>2025년 6월 20일 오후 4:54</checkDate>
                    </w2:data>
                </w2:dataMap>
            </w2:dataCollection>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    // 메시지 설정
    var checkTime = dma_checkout.get("checkTime");
    var message = checkTime + "에 퇴근처리됩니다.";
    
    spn_checkoutMsg.setValue(message);
    spn_question.setValue("퇴장하시겠습니까?");
};]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
        <!-- 팝업 헤더 -->
        
        <!-- 팝업 내용 -->
        <xf:group class="" id="grp_content" style="padding:0px 40px;text-align:center;background-color:white;min-height:200px;">
            <w2:textbox class="" id="spn_checkoutMsg" style="font-size:20px;color:#333;font-weight:bold;display:block;margin-bottom:10px;" label="16:54에 퇴근처리됩니다."/>
            <w2:textbox class="" id="spn_question" style="font-size:20px;color:#333;font-weight:bold;display:block;margin-bottom:30px;" label="퇴장하시겠습니까?"/>
            <w2:textbox class="" id="spn_date" ref="data:dma_checkout.checkDate" style="font-size:16px;color:#666;display:block;margin-bottom:40px;" label="2025년 6월 20일 오후 4:54"/>
            
            <!-- 버튼 그룹 -->
            <xf:trigger class="" id="btn_checkout" style="background-color:#F44336;color:white;padding:12px 30px;border-radius:8px;font-size:16px;font-weight:bold;border:none;cursor:pointer;margin-right:15px;" ev:onclick="scwin.processCheckout()" type="button">
                <xf:label>퇴장</xf:label>
            </xf:trigger>
            <xf:trigger class="" id="btn_cancel" style="background-color:#E0E0E0;color:#666;padding:12px 30px;border-radius:8px;font-size:16px;font-weight:bold;border:none;cursor:pointer;" ev:onclick="scwin.closePopup()" type="button">
                <xf:label>취소</xf:label>
            </xf:trigger>
        </xf:group>
    </body>
</html>
