		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {
    // 모바일 버튼 스타일 초기화
    scwin.initMobileButtons();
    
    // 숫자 애니메이션 함수 호출
    scwin.animateCounters();
};

// 모바일 버튼 초기화
scwin.initMobileButtons = function() {
    var primaryBtns = document.querySelectorAll('.mobile-btn-primary');
    var secondaryBtns = document.querySelectorAll('.mobile-btn-secondary');
    
    primaryBtns.forEach(function(btn) {
        btn.style.backgroundColor = '#3674B5';
        btn.style.color = '#ffffff';
        btn.style.border = 'none';
    });
    
    secondaryBtns.forEach(function(btn) {
        btn.style.backgroundColor = 'transparent';
        btn.style.color = '#3674B5';
        btn.style.border = '2px solid #3674B5';
    });
};

// 모바일 메뉴 토글
scwin.mobileMenu_onclick = function(e) {
    // 모바일 메뉴 로직 (추후 구현)
    alert('메뉴가 열립니다');
};

// 모바일 버튼 호버 효과
scwin.mobilePrimaryBtn_onmouseover = function(e) {
    var btn = e.target || e.srcElement;
    btn.style.backgroundColor = '#2C5A94';
};

scwin.mobilePrimaryBtn_onmouseout = function(e) {
    var btn = e.target || e.srcElement;
    btn.style.backgroundColor = '#3674B5';
};

scwin.mobileSecondaryBtn_onmouseover = function(e) {
    var btn = e.target || e.srcElement;
    btn.style.backgroundColor = '#3674B5';
    btn.style.color = '#ffffff';
};

scwin.mobileSecondaryBtn_onmouseout = function(e) {
    var btn = e.target || e.srcElement;
    btn.style.backgroundColor = 'transparent';
    btn.style.color = '#3674B5';
};

// CTA 버튼 호버
scwin.mobileCTABtn_onmouseover = function(e) {
    var btn = e.target || e.srcElement;
    btn.style.backgroundColor = 'rgba(255, 255, 255, 0.1)';
};

scwin.mobileCTABtn_onmouseout = function(e) {
    var btn = e.target || e.srcElement;
    btn.style.backgroundColor = 'transparent';
};

// 회원가입 페이지 이동
scwin.mobileRegister_onclick = function(e) {
    window.location.href = '/InsWebApp/websquare/websquare.html?w2xPath=/InsWebApp/main/unicon_join_mobile.xml';
};

// 로고 클릭시 새로고침
scwin.mobileLogo_onclick = function(e) {
    window.location.reload();
};

// 숫자 애니메이션 (모바일 최적화)
scwin.animateCounters = function() {
    var counters = [
        { id: 'mobile_counter1', target: 10000, suffix: '+', duration: 2000 },
        { id: 'mobile_counter2', target: 99.9, suffix: '%', duration: 2000 },
        { id: 'mobile_counter3', target: 24, suffix: '/7', duration: 1500 },
        { id: 'mobile_counter4', target: 50, suffix: '%', duration: 1800 }
    ];

    counters.forEach(function(counter) {
        scwin.animateCounterById(counter.id, counter.target, counter.suffix, counter.duration);
    });
};

scwin.animateCounterById = function(id, target, suffix, duration) {
    var component = $p.getComponentById(id);
    if (!component) return;

    var startTime = null;
    var startValue = 0;

    function animate(currentTime) {
        if (!startTime) startTime = currentTime;
        var progress = (currentTime - startTime) / duration;

        if (progress >= 1) {
            var finalValue = target >= 1000 ? target.toLocaleString() + suffix : target + suffix;
            component.setValue(finalValue);
            return;
        }

        var easedProgress = 1 - Math.pow(1 - progress, 3);
        var currentValue = startValue + (target - startValue) * easedProgress;
        
        var displayValue;
        if (target === 99.9) {
            displayValue = currentValue.toFixed(1);
        } else if (target >= 1000) {
            displayValue = Math.floor(currentValue).toLocaleString();
        } else {
            displayValue = Math.floor(currentValue);
        }

        component.setValue(displayValue + suffix);
        requestAnimationFrame(animate);
    }

    requestAnimationFrame(animate);
};
]]>
