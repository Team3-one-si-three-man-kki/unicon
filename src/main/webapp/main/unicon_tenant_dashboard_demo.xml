		<script type="text/javascript" lazy="false"><![CDATA[scwin.onpageload = function () {
    
    const urlParams = new URLSearchParams(window.location.search);

    const tenantName = urlParams.get('tenant');

    if (tenantName) {
        console.log("URL에서 가져온 테넌트 이름:", tenantName);
        // 나중에 이 tenantName 변수를 submission 등에 활용할 수 있습니다.
    } else {
        console.log("URL에 'tenant' 파라미터가 없습니다.");
    }

    // '사용자 관리' 탭을 기본으로 표시합니다.
    scwin.showPanel('user');

    // 사용자 목록을 조회합니다.
    scwin.btn_search_onclick();


};

scwin.showPanel = function (panelType) {
    // 모든 관련 패널을 숨깁니다.
    grp_userManagement_wrapper.hide();
    grp_moduleMarketplace.hide();

    // 선택된 타입에 맞는 패널만 보여줍니다.
    if (panelType === 'user') {
        grp_userManagement_wrapper.show();
    } else if (panelType === 'module') {
        grp_moduleMarketplace.show();
    } else {
        alert(panelType + " 메뉴입니다.");
    }
};

scwin.toggleSidebar = function () {
    var wrap = $p.getComponentById("wrap");
    if (wrap.hasClass("sidebar-collapsed")) {
        wrap.removeClass("sidebar-collapsed");
    } else {
        wrap.addClass("sidebar-collapsed");
    }
};


scwin.btn_insert_onclick = function (e) { var _rowIdx = userList.insertRow(); };
scwin.btn_delete_onclick = function (e) { var focusIdx = grd.getFocusedRowIndex(); if (focusIdx < 0) { alert("삭제할 행을 먼저 선택해주세요."); return; } user.deleteRow(focusIdx); };
scwin.btn_remove_onclick = function (e) { var focusIdx = grd.getFocusedRowIndex(); if (focusIdx < 0) { alert("삭제할 행을 먼저 선택해주세요."); return; } var removeData = user.removeRow(focusIdx); console.log("삭제된 데이터:", JSON.stringify(removeData)); };
scwin.btn_deleteRows_onclick = function (e) { var chkIdxArr = grd.getCheckedIndex("CHK"); userList.deleteRows(chkIdxArr); };
scwin.btn_removeRows_onclick = function (e) { var chkIdxArr = grd.getCheckedIndex("CHK"); let removeObjs = userList.removeRows(chkIdxArr); console.log(JSON.stringify(removeObjs)); };
scwin.btn_reset_onclick = function (e) { userList.setData([]); };
scwin.btn_down_onclick = function (e) { grd.advancedExcelDownload({}); };
scwin.btn_upload_onclick = function (e) { var options = {}; options.headerExist = "1"; options.type = "1"; options.status = "C"; grd.advancedExcelUpload(options); };

scwin.btn_search_onclick = function (e) {
    $p.executeSubmission("sbm_selectTenantUser");
};

scwin.ui_schRole_onviewchange = function (info) { userList.clearFilter(); userList.setColumnFilter({ type: 'row', colIndex: 'role', key: info.newValue, condition: 'and' }); };


scwin.sbm_selectTenantUser_submitdone = function (e) {
    var receivedData = e.responseJSON;

    // 서버에서 에러 없이 데이터가 배열 형태로 왔는지 확인
    if (Array.isArray(receivedData)) {
        userList.setJSON(receivedData);
    } else {
        // elHeader와 같은 커스텀 에러 처리 로직이 있다면 여기에 구현
        var elHeader = receivedData.elHeader;
        if (elHeader && elHeader.resSuc === false) {
            $c.win.alert(`에러코드 : ${elHeader.resCode}\n에러메시지 : ${elHeader.resMsg}`);
        }
    }
};

scwin.sbm_saveAllUser_submitdone = function (e) {
    alert("저장이 완료되었습니다.");
    scwin.btn_search_onclick();
};]]></script>
