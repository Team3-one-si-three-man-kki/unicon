        } else {
            console.log("Grid 컴포넌트가 존재하지 않음 - ID 확인 필요");
        }
    } catch (error) {
        console.log("Grid 확인 중 오류:", error);
    }
};

scwin.grid_oncellvaluechange = function (e) {
    console.log("그리드 셀 값 변경:", e);

    if (e.colId === "email") {
        const emailValue = e.newValue;
        console.log("이메일 컬럼 변경 감지. 새 값:", emailValue);

        if (!emailValue || emailValue.trim() === "") {
            console.log("이메일이 비어있어 검사를 건너뜁니다.");
            return;
        }

        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRegex.test(emailValue)) {
            alert("올바른 이메일 형식이 아닙니다.");
            return;
        }

        const rowStatus = userList.getRowStatus(e.rowIndex);
        if (rowStatus !== "C" && e.newValue === e.oldValue) {
            console.log("이메일이 변경되지 않아 중복검사를 건너뜁니다.");
            return;
        }

        const tenantId = "1";

        console.log("emailCheckData 설정 시작...");

        try {
            const emailCheckDataMap = $p.getComponentById("emailCheckData");

            if (emailCheckDataMap) {
                emailCheckDataMap.set("email", emailValue);
                emailCheckDataMap.set("tenantId", tenantId);

                console.log("이메일 중복검사 서브미션 실행. 전송 데이터:", emailCheckDataMap.getJSON());

                // 중복검사 서브미션 실행
                $p.executeSubmission("mf_sbm_checkEmailByTenant");
            } else {
                console.error("sbm_checkEmailByTenant_submitdone  DataMap을 찾을 수 없습니다.");
                alert("이메일 중복검사 설정에 오류가 발생했습니다.");
            }

        } catch (error) {
            console.error("이메일 중복검사 실행 중 오류:", error);
            alert("이메일 중복검사 설정에 오류가 발생했습니다: " + error.message);
        }
    }
};

scwin.testEmailCheck = function (email, tenantId) {
    if (!email) email = "test@example.com";
    if (!tenantId) tenantId = "1";

    console.log("수동 이메일 중복검사 실행:", email, tenantId);

    try {
        const emailCheckDataMap = $p.getComponentById("emailCheckData");
        if (emailCheckDataMap) {
            emailCheckDataMap.set("email", email);
            emailCheckDataMap.set("tenantId", tenantId);
            console.log("테스트 데이터 설정:", emailCheckDataMap.getJSON());
            $p.executeSubmission("sbm_checkEmailByTenant");
        } else {
            console.error("emailCheckData DataMap을 찾을 수 없습니다.");
        }
    } catch (error) {
        console.error("테스트 실행 중 오류:", error);
    }
};]]></script>
