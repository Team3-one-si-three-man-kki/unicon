            console.log("Action URL:", submission.action);
        } else {
            console.log("sbm_checkEmailByTenant submission이 존재하지 않음");
        }
    } catch (error) {
        console.log("Submission 확인 중 오류:", error);
    }

    try {
        const gridComponent = $p.getComponentById("grd");
        if (gridComponent) {
            console.log("Grid 컴포넌트 존재");
