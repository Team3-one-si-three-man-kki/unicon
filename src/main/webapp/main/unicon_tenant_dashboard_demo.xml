		<script type="text/javascript" lazy="false"><![CDATA[scwin.onpageload = function () {

    const urlParams = new URLSearchParams(window.location.search);

    const tenantName = urlParams.get('tenant');

    if (tenantName) {
        console.log("URL에서 가져온 테넌트 이름:", tenantName);

    } else {
        console.log("URL에 'tenant' 파라미터가 없습니다.");
    }

    scwin.showPanel('user');

    scwin.btn_search_onclick();


};

scwin.showPanel = function (panelType) {
    grp_userManagement_wrapper.hide();
    grp_moduleMarketplace.hide();

    if (panelType === 'user') {
        grp_userManagement_wrapper.show();
    } else if (panelType === 'module') {
        grp_moduleMarketplace.show();
    } else {
        alert(panelType + " 메뉴입니다.");
    }
};

scwin.toggleSidebar = function () {
    var wrap = $p.getComponentById("wrap");
    if (wrap.hasClass("sidebar-collapsed")) {
        wrap.removeClass("sidebar-collapsed");
    } else {
        wrap.addClass("sidebar-collapsed");
    }
};


scwin.btn_insert_onclick = function (e) {
    var _rowIdx = userList.insertRow();
    userList.setCellData(_rowIdx, "tenantId", "1");
};
scwin.btn_delete_onclick = function (e) { var focusIdx = grd.getFocusedRowIndex(); if (focusIdx < 0) { alert("삭제할 행을 먼저 선택해주세요."); return; } userList.deleteRow(focusIdx); };
scwin.btn_remove_onclick = function (e) { var focusIdx = grd.getFocusedRowIndex(); if (focusIdx < 0) { alert("삭제할 행을 먼저 선택해주세요."); return; } var removeData = userList.removeRow(focusIdx); console.log("삭제된 데이터:", JSON.stringify(removeData)); };
scwin.btn_deleteRows_onclick = function (e) { var chkIdxArr = grd.getCheckedIndex("chk"); userList.deleteRows(chkIdxArr); };
scwin.btn_removeRows_onclick = function (e) { var chkIdxArr = grd.getCheckedIndex("chk"); let removeObjs = userList.removeRows(chkIdxArr); console.log(JSON.stringify(removeObjs)); };
scwin.btn_reset_onclick = function (e) { userList.setData([]); };
scwin.btn_down_onclick = function (e) { grd.advancedExcelDownload({}); };
scwin.btn_upload_onclick = function (e) { var options = {}; options.headerExist = "1"; options.type = "1"; options.status = "C"; grd.advancedExcelUpload(options); };
scwin.btn_search_onclick = function (e) {
    const urlParams = new URLSearchParams(window.location.search);
    const tenantIdFromUrl = "1"; // 또는 urlParams.get('tenant');

    var userDetailDataMap = $p.getComponentById("userDetail");

    if (userDetailDataMap) {
        userDetailDataMap.set("tenantId", tenantIdFromUrl);
    } else {
        alert("userDetail DataMap을 찾을 수 없습니다. XML의 ID를 확인해주세요.");
        return;
    }

    console.log("'sbm_selectUserList' 서브미션을 실행합니다. 전송 데이터:", userDetailDataMap.getJSON());
    $p.executeSubmission("sbm_selectUserList");
};

scwin.ui_schRole_onviewchange = function (info) { userList.clearFilter(); userList.setColumnFilter({ type: 'row', colIndex: 'role', key: info.newValue, condition: 'and' }); };


scwin.sbm_selectTenantUser_submitdone = function (e) {
    var receivedData = e.responseJSON;

    if (Array.isArray(receivedData)) {
        userList.setJSON(receivedData);
    } else {
        // elHeader와 같은 커스텀 에러 처리 로직이 있다면 여기에 구현
        var elHeader = receivedData.elHeader;
        if (elHeader && elHeader.resSuc === false) {
            $c.win.alert(`에러코드 : ${elHeader.resCode}\n에러메시지 : ${elHeader.resMsg}`);
        }
    }
};

scwin.sbm_saveAllUser_submitdone = function (e) {
    alert("저장이 완료되었습니다.");
    scwin.btn_search_onclick();
};

/**
 * @description 테넌트별 사용자 목록 조회 콜백 함수
 */
scwin.sbm_selectUserList_submitdone = function (e) {
    console.log("서버 응답 원본:", e.responseJSON);

    var responseData = e.responseJSON;

    var userArray = responseData.elData.userVoList;



    if (userArray && Array.isArray(userArray)) {
        userList.setJSON(userArray);
    } else {
        userList.removeAll();
        console.error("서버 응답에서 유효한 사용자 목록 배열을 찾을 수 없습니다. 응답 구조를 확인하세요.");
    }

    console.log("DataList('userList')에 최종적으로 담긴 데이터:", userList.getAllJSON());
};

scwin.sbm_saveUserList_submitdone = function (e) {
    alert("저장이 완료되었습니다.");
    // 데이터 재조회하여 화면 갱신
    scwin.btn_search_onclick();
};

/**
 * @description 저장 버튼 클릭 이벤트
 */
scwin.btn_save_onclick = function (e) {
    console.log("저장 버튼 클릭됨");

    var dataList = $p.getComponentById("userList");
    if (!dataList) {
        console.error("userList DataList를 찾을 수 없습니다.");
        alert("데이터 목록을 찾을 수 없습니다.");
        return;
    }

    var modifiedData = dataList.getModifiedJSON();
    console.log("변경된 데이터:", modifiedData);

    if (modifiedData.length === 0) {
        alert("저장할 변경사항이 없습니다.");
        return;
    }

    if (confirm("변경 내용을 저장하시겠습니까?")) {
        console.log("서버로 전송할 데이터:", modifiedData);

        try {
            $p.executeSubmission("sbm_saveUserList");
            console.log("✅ 저장 서브미션 실행 완료");
        } catch (error) {
            console.error("❌ 저장 서브미션 실행 실패:", error);
            alert("저장 중 오류가 발생했습니다: " + error.message);
        }
    }
};

console.log("✅ 저장 버튼 함수 수정 완료!");
scwin.sbm_checkEmailByTenant_submitdone = function (e) {
    console.log("이메일 중복검사 완료:", e);

    try {
        const response = e.responseJSON;
        console.log("서버 응답:", response);

        if (!response) {
            console.error("서버 응답이 없습니다.");
            alert("이메일 중복검사 중 오류가 발생했습니다.");
            return;
        }

        let emailCheckResult;
        let email;

        if (response.elData) {
            // elData 구조인 경우
            emailCheckResult = response.elData.emailCheckResult || response.elData.result;
            email = response.elData.email;
        } else {
            // 단순 JSON 응답인 경우
            emailCheckResult = response.emailCheckResult || response.result;
            email = response.email;
        }

        console.log("이메일 검사 결과:", emailCheckResult, "이메일:", email);

        if (emailCheckResult === "unavailable" || emailCheckResult === false) {
            alert("'" + email + "'은(는) 이미 사용 중인 이메일입니다.\n다른 이메일을 입력해주세요.");

            // 포커스를 해당 셀로 이동
            const gridComponent = $p.getComponentById("grd");
            if (gridComponent) {
                const currentRowIndex = gridComponent.getFocusedRowIndex();
                if (currentRowIndex >= 0) {
                    gridComponent.focusCell(currentRowIndex, "email");
                }
            }
        } else if (emailCheckResult === "available" || emailCheckResult === true) {
            console.log("이메일 사용 가능:", email);
            // 성공 메시지는 표시하지 않고 로그만 남김
        } else {
            console.warn("알 수 없는 이메일 검사 결과:", emailCheckResult);
            alert("이메일 중복검사 결과를 확인할 수 없습니다.");
        }

    } catch (error) {
        console.error("응답 처리 중 오류:", error);
        alert("이메일 중복검사 응답 처리 중 오류가 발생했습니다: " + error.message);
    }
};
scwin.debugEmailCheck = function () {
    console.log("=== 이메일 중복검사 디버깅 정보 ===");

    try {
        const emailCheckDataMap = $p.getComponentById("emailCheckData");
        if (emailCheckDataMap) {
            console.log("emailCheckData 존재:", emailCheckDataMap.getJSON());
        } else {
            console.log("emailCheckData가 존재하지 않음");
        }
    } catch (error) {
        console.log("emailCheckData 확인 중 오류:", error);
    }

    try {
        const submission = $p.getSubmission("sbm_checkEmailByTenant");
        if (submission) {
