		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {
    var parentData = $p.parent().scwin.sessionData;
    txt_name.setLabel(parentData.sessionInfo.name);
    txt_start.setLabel(formatDateTime(parentData.sessionInfo.start_time));
    txt_end.setLabel(formatDateTime(parentData.sessionInfo.end_time));
    //txt_link.setLabel(parentData.generatedInfo.inviteLink);


    // 날짜 형식 변환 함수
    function formatDateTime(dateTimeStr) {
        if (!dateTimeStr || dateTimeStr.length !== 12) {
            return dateTimeStr;
        }

        // "202507090000" -> "2025-07-09 00:00:00"
        var year = dateTimeStr.substring(0, 4);
        var month = dateTimeStr.substring(4, 6);
        var day = dateTimeStr.substring(6, 8);
        var hour = dateTimeStr.substring(8, 10);
        var minute = dateTimeStr.substring(10, 12);

        return year + '-' + month + '-' + day + ' ' + hour + ':' + minute + ':00';
    }
};

// make_session_complete.xml의 버튼 클릭
scwin.btn_complete_onclick = function (e) {
    console.log("시작 버튼 클릭됨");
    // 부모의 saveAllSessionData 호출하면서 완료 후 콜백 전달
    $p.parent().scwin.saveAllSessionData(function (sessionId) {
        // 성공 시 부모 페이지에서 이동 처리
        $p.parent().scwin.navigateToLayout(sessionId);
    });
};
]]></script>
