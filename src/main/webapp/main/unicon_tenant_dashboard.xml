		<script type="text/javascript" lazy="false"><![CDATA[
            scwin.onpageload = function() {
                // 페이지 로딩 시 초기화
            };
            
            /**
             * 사이드바 토글 기능
             * 메인 wrapper 그룹에 'sidebar-collapsed' 클래스를 추가/제거하여 CSS로 제어합니다.
             */
            scwin.toggleSidebar = function() {
                var wrap = $p.getComponentById("wrap"); // ID가 "wrap"인 최상위 그룹을 가져옵니다.
                
                if (wrap.hasClass("sidebar-collapsed")) {
                    wrap.removeClass("sidebar-collapsed");
                } else {
                    wrap.addClass("sidebar-collapsed");
                }
            };
        ]]></script>
		<style><![CDATA[
            /* ========== 기본 레이아웃 및 애니메이션 ========== */
            .main-container { display: flex; flex-direction: column; height: 100vh; }
            .main-header { flex-shrink: 0; display: flex; align-items: center; padding: 0 20px; height: 60px; border-bottom: 1px solid #eee; }
            .btn_toggle_menu { font-size: 24px; cursor: pointer; background: none; border: none; }

            .wrap { display: flex; height: 100%; overflow: hidden; }
            .lnb_wrap { 
                flex-shrink: 0; width: 260px; background-color: #3c335d; color: white; 
                display: flex; flex-direction: column; padding: 20px;
                transition: width 0.3s ease-in-out, padding 0.3s ease-in-out; /* 부드러운 효과 */
            }
            .container_wrap { flex-grow: 1; padding: 25px 35px; overflow-y: auto; }
            
            /* ========== 사이드바가 닫혔을 때의 스타일 ========== */
            .wrap.sidebar-collapsed .lnb_wrap {
                width: 0;
                padding-left: 0;
                padding-right: 0;
                overflow: hidden;
            }

            /* ========== 사이드바 내부 요소 스타일 ========== */
            .lnb_wrap .logo { font-size: 24px; font-weight: bold; color: white; padding-bottom: 20px; white-space: nowrap; }
            .lnb_wrap .pro_banner { background-color: #4a416a; border-radius: 8px; padding: 15px; margin-bottom: 20px; white-space: nowrap; }
            .lnb_wrap .pro_banner .title { font-weight: bold; font-size: 14px; display: block; margin-bottom: 5px;}
            .lnb_wrap .pro_banner .desc { font-size: 12px; display: block; opacity: 0.8; }
            .lnb_wrap .snb { flex-grow: 1; background-color: transparent !important; color: white !important; border: none; white-space: nowrap; }
            .lnb_wrap .w2_menu_item_label { color: #ccc !important; }
            .lnb_wrap .w2_menu_item.w2_menu_selected > .w2_menu_item_label { color: white !important; font-weight: bold; }
            .lnb_wrap .lnb_footer { font-size: 11px; opacity: 0.7; line-height: 1.6; white-space: nowrap; }
            .lnb_wrap .lnb_footer p { margin:0; }
        ]]></style>
