<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:ev="http://www.w3.org/2001/xml-events"
      xmlns:w2="http://www.inswave.com/websquare"
      xmlns:xf="http://www.w3.org/2002/xforms">

<head>
    <w2:type>DEFAULT</w2:type>
    <w2:buildDate />
    <title>미팅룸 관리</title>

    <xf:model>
        <xf:instance>
            <data xmlns="" />
        </xf:instance>

        <w2:dataCollection baseNode="map">
            <w2:dataList id="dlt_rooms" baseNode="list" repeatNode="map" valueNode="">
                <w2:columnInfo>
                    <w2:column id="id" name="룸 ID" dataType="text"></w2:column>
                    <w2:column id="peerCount" name="참여자수" dataType="number"></w2:column>
                    <w2:column id="speaker" name="발언자" dataType="text"></w2:column>
                </w2:columnInfo>
            </w2:dataList>

            <w2:dataMap id="dmp_roomDetail" baseNode="map">
                <w2:keyInfo>
                    <w2:key id="id" name="룸 ID" dataType="text"></w2:key>
                    <w2:key id="routerId" name="라우터 ID" dataType="text"></w2:key>
                    <w2:key id="adminPeerId" name="관리자 ID" dataType="text"></w2:key>
                    <w2:key id="peerCount" name="참여자수" dataType="number"></w2:key>
                </w2:keyInfo>
            </w2:dataMap>

            <w2:dataList id="dlt_peers" baseNode="list" repeatNode="map" valueNode="">
                <w2:columnInfo>
                    <w2:column id="name" name="이름" dataType="text"></w2:column>
                    <w2:column id="email" name="이메일" dataType="text"></w2:column>
                    <w2:column id="video" name="비디오" dataType="text"></w2:column>
                    <w2:column id="audio" name="오디오" dataType="text"></w2:column>
                </w2:columnInfo>
            </w2:dataList>
        </w2:dataCollection>
    </xf:model>

    <script type="text/javascript" lazy="false"><![CDATA[
        scwin.onpageload = function() {
            scwin.loadSample();
        };

        // 샘플 데이터 로드
        scwin.loadSample = function() {
            var rooms = [
                {
                    id: "my-fia-room",
                    peers: [
                        { name: "test1", email: "test1@test.com", video: "Y", audio: "Y" },
                        { name: "test2", email: "test2@test.com", video: "Y", audio: "Y" }
                    ],
                    speaker: "test1",
                    routerId: "d8d3ef21-061c-4eda-9441-5ca9d2e13ffb",
                    adminPeerId: "3f5678c7-4982-455f-9ed4-bd2643eedab8"
                },
                {
                    id: "team-meeting-001",
                    peers: [
                        { name: "Admin User", email: "admin@company.com", video: "N", audio: "Y" }
                    ],
                    speaker: "Admin User",
                    routerId: "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                    adminPeerId: "12345678-9abc-def0-1234-567890abcdef"
                }
            ];

            // rooms 데이터를 scwin 객체에 저장하여 전역에서 사용 가능하게 함
            scwin.sampleRooms = rooms;

            // 룸 목록 세팅
            var roomRows = [];
            for (var i = 0; i < rooms.length; i++) {
                var r = rooms[i];
                roomRows.push({ id: r.id, peerCount: r.peers.length, speaker: r.speaker });
            }
            dlt_rooms.setJSON(roomRows);
        };

        // 룸 선택 시 상세 표시
        scwin.grd_rooms_oncellclick = function(row, col) {
            // 선택한 행의 룸 ID 가져오기
            var selectedRoomId = dlt_rooms.getCellData(row, "id");

            // scwin.sampleRooms에서 해당 ID를 가진 룸 데이터 찾기
            var roomDetail = scwin.sampleRooms.find(function(room) {
                return room.id === selectedRoomId;
            });

            if (roomDetail) {
                // 찾은 데이터로 상세 정보(dmp_roomDetail)와 참여자 목록(dlt_peers)을 채움
                dmp_roomDetail.setJSON(roomDetail);
                dlt_peers.setJSON(roomDetail.peers);
            } else {
                // 데이터가 없는 경우 초기화
                dmp_roomDetail.setJSON({});
                dlt_peers.setJSON([]);
            }
        };
    ]]></script>
</head>

<body>
    <w2:group id="grp_main" style="width:100%;height:100%;padding:20px;" tagname="div">
        <w2:textbox id="txt_title" value="미팅룸 관리" style="font-size:20px;font-weight:bold;margin-bottom:10px;" tagname="h1" />

        <w2:gridView id="grd_rooms" dataList="data:dlt_rooms" style="width:45%;height:400px;float:left;margin-right:5%;" visibleRowNum="8" rowNumVisible="true" rowNumHeaderValue="No" useFilterList="true">
            <w2:header>
                <w2:row>
                    <w2:column id="cid1" value="룸 ID" width="200" />
                    <w2:column id="cid2" value="참여자" width="80" />
                    <w2:column id="cid3" value="발언자" width="120" />
                </w2:row>
            </w2:header>
            <w2:gBody>
                <w2:row>
                    <w2:column id="id" />
                    <w2:column id="peerCount" />
                    <w2:column id="speaker" />
                </w2:row>
            </w2:gBody>
            <w2:script ev:event="oncellclick(row, col)"><![CDATA[scwin.grd_rooms_oncellclick(row,col);]]></w2:script>
        </w2:gridView>

        <w2:group id="grp_detail" style="width:40%;float:left;" tagname="div">
            <w2:fieldset id="fs_detail" legend="미팅룸 상세" style="width:100%;padding:15px;">
                <w2:span label="룸 ID:" /> <w2:textbox id="tb_detail_id" ref="data:dmp_roomDetail.id" readOnly="true"/> <br/>
                <w2:span label="라우터 ID:" /> <w2:textbox id="tb_detail_router" ref="data:dmp_roomDetail.routerId" readOnly="true"/> <br/>
                <w2:span label="관리자 ID:" /> <w2:textbox id="tb_detail_admin" ref="data:dmp_roomDetail.adminPeerId" readOnly="true"/> <br/>
                <w2:span label="참여자 수:" /> <w2:textbox id="tb_detail_peercnt" ref="data:dmp_roomDetail.peerCount" readOnly="true"/> <br/>
            </w2:fieldset>
            <w2:gridView id="grd_peers" dataList="data:dlt_peers" style="width:100%;height:250px;margin-top:10px;" visibleRowNum="5">
                <w2:header>
                    <w2:row>
                        <w2:column id="c1" value="이름" width="120" />
                        <w2:column id="c2" value="이메일" width="200" />
                        <w2:column id="c3" value="비디오" width="70" />
                        <w2:column id="c4" value="오디오" width="70" />
                    </w2:row>
                </w2:header>
                <w2:gBody>
                    <w2:row>
                        <w2:column id="name" />
                        <w2:column id="email" />
                        <w2:column id="video" />
                        <w2:column id="audio" />
                    </w2:row>
                </w2:gBody>
            </w2:gridView>
        </w2:group>
    </w2:group>
</body>
</html>