<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
            <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
                <w2:dataMap baseNode="map" id="dma_attendance">
                    <w2:keyInfo>
                        <w2:key dataType="text" name="사용자명" id="userName"/>
                        <w2:key dataType="text" name="체크시간" id="checkTime"/>
                        <w2:key dataType="text" name="체크날짜" id="checkDate"/>
                    </w2:keyInfo>
                    <w2:data use="true">
                        <userName>김민수</userName>
                        <checkTime>9:00</checkTime>
                        <checkDate>2024년 6월 20일 오전 9:00</checkDate>
                    </w2:data>
                </w2:dataMap>
            </w2:dataCollection>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
    // 메시지 설정
    var userName = dma_attendance.get("userName");
    var checkTime = dma_attendance.get("checkTime");
    var message = userName + "님 " + checkTime + "에 출석체크되었습니다";
    
    spn_mainMsg.setValue(message);
};

scwin.closePopup = function() {
    $p.closePopup();
};

scwin.confirmAttendance = function() {
    $p.closePopup({
        result: "confirmed",
        message: "출석이 확인되었습니다."
    });
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
        <!-- 팝업 헤더 -->
        <xf:group class="" id="grp_header" style="background-color:#4CAF50;height:60px;padding:15px 20px;position:relative;">
            <xf:group class="" id="grp_headerLeft" style="float:left;">
                <w2:textbox class="" id="txt_icon"
                    style="display:inline-block;width:30px;height:30px;background-color:white;border-radius:15px;text-align:center;line-height:30px;color:#4CAF50;font-weight:bolder;margin-right:15px;font-size:16px;"
                    label="V"/>
                <w2:textbox class="" id="txt_title" style="color:white;font-size:18px;font-weight:bold;line-height:30px;" label="출석 확인"/>
            </xf:group>
            <xf:group class="" id="grp_headerRight" style="float:right;">
                <w2:anchor class="" id="anc_close"
                    style="display:inline-block;width:30px;height:30px;background-color:rgba(255,255,255,0.2);border-radius:15px;text-align:center;line-height:30px;color:white;cursor:pointer;font-size:18px;font-weight:bolder;"
                    ev:onclick="scwin.closePopup()">
                    <xf:label>X</xf:label>
                </w2:anchor>
            </xf:group>
            <w2:textbox class="" id="txt_clear" style="clear:both;" label=""/>
        </xf:group>

        <!-- 팝업 내용 -->
        <xf:group class="" id="grp_content" style="padding:60px 40px;text-align:center;background-color:white;min-height:200px;">
            <w2:textbox class="" id="spn_mainMsg"
                style="font-size:24px;color:#333;font-weight:bold;display:block;margin-bottom:30px;line-height:1.4;" label=""/>
            <w2:textbox class="" id="spn_date" ref="data:dma_attendance.checkDate"
                style="font-size:16px;color:#666;display:block;margin-bottom:40px;" label=""/>

            <!-- 확인 버튼 -->
            <xf:trigger class="" id="btn_confirm"
                style="background-color:#2196F3;color:white;padding:12px 40px;border-radius:8px;font-size:16px;font-weight:bold;border:none;cursor:pointer;"
                ev:onclick="scwin.confirmAttendance()" type="button">
                <xf:label>확인</xf:label>
            </xf:trigger>
        </xf:group>
    </body>
</html>
